# Investment Agent — environment variables
# Copy to .env and fill in your values. Never commit .env to version control.
# `python run.py ...` loads this project-local .env before importing app code.

# JQData (聚宽) — optional only.
# Current mine setup intentionally keeps JQData disabled and uses
# AkShare/THS/Eastmoney public interfaces + official filings/PDF for A-share research.
# Uncomment only if you explicitly re-enable JQData later.
# JQ_USER=your_jqdata_username
# JQ_PASS=your_jqdata_password

# Optional LLM CLI bridge used by app/services/llm_client.py.
# Defaults to: claude --print --tools '' --no-session-persistence
# Set these when you want Investment-Agent to call a different non-interactive CLI.
# INVESTMENT_AGENT_LLM_CMD=codex
# INVESTMENT_AGENT_LLM_ARGS="--ask-for-approval never exec"

# Optional provider keys for whichever CLI/provider you configure above.
# These are pass-through environment variables; Investment-Agent itself does not
# call OpenAI/Anthropic SDKs directly from this file.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
