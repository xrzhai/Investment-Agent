#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="${INVESTMENT_AGENT_PYTHON:-${MINE_WORK_PYTHON:-/mnt/c/Users/zhaix/miniconda3/envs/work/python.exe}}"
if [[ ! -x "$PY" ]]; then
  echo "Investment-Agent launcher: Python runtime not found or not executable: $PY" >&2
  echo "Set INVESTMENT_AGENT_PYTHON or MINE_WORK_PYTHON to override." >&2
  exit 127
fi
cd "$ROOT"
exec "$PY" run.py "$@"
